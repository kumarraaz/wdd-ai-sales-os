# ── WDD AI SALES OS — environment template ──────────────────────────────
# Copy to .env.local for development. NEVER commit real values.

# ── Database (required) ─────────────────────────────────────────────────
# Neon (recommended) / Supabase / any PostgreSQL with pgvector extension.
DATABASE_URL="postgresql://user:password@host:5432/wdd_sales_os?sslmode=require"

# ── Auth (required) ─────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET="CHANGE_ME_generate_with_openssl_rand_base64_32"
# Public app URL (used for OAuth callbacks + email links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Public site URL for SEO metadata (canonical + Open Graph). Set to the
# production domain at deploy time; falls back to the vercel.app URL.
NEXT_PUBLIC_SITE_URL="https://wdd-ai-sales-os.vercel.app"

# ── Google OAuth (optional — login button hidden when unset) ─────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Set to "true" to show the Google button (requires the two vars above).
NEXT_PUBLIC_GOOGLE_OAUTH="false"

# ── Email (required in production for verification + password reset) ─────
BREVO_API_KEY=""
EMAIL_FROM="WDD AI Sales OS <noreply@yourdomain.com>"

# ── AI providers (Phase 3+; at least one needed for AI features) ──────────
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# ── Rate limiting (optional — in-memory fallback used when unset) ─────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Background jobs (Phase 4+ — Inngest) ──────────────────────────────────
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# ── Seed helper (optional) ────────────────────────────────────────────────
SEED_DEMO_USER_EMAIL=""

# ── Demo mode (development only — NEVER enable in production) ─────────────
# DEMO_MODE=true shows a "View Demo" button on the login page that opens the
# app shell with clearly labeled DEMO_DATA fixtures — no account, no email
# verification. Hard-gated: it can never activate when NODE_ENV=production.
# Writes and external actions are blocked with "Demo Mode — Action Disabled".
# DEMO_MODE=false

# ── Discovery providers (lead acquisition workspace) ──────────────────────
# Server-side only. NEVER expose as NEXT_PUBLIC_* — keys are sent from API
# routes and never reach the browser. NEVER commit real values.
#
# OpenStreetMap/Overpass is the FREE DEFAULT — no key required.
# GOOGLE_PLACES_API_KEY is OPTIONAL but recommended (best coverage).
# When unset, Google Places is simply unavailable; other sources still work.
GOOGLE_PLACES_API_KEY=

# Geoapify Places (optional secondary source, 3,000 credits/day free).
GEOAPIFY_API_KEY=

# Tavily web search (optional, 1,000 credits/month free).
TAVILY_API_KEY=

# Brave Search (optional fallback web provider).
BRAVE_SEARCH_API_KEY=

# Groq AI inference (optional AI provider — NOT a web search provider).
# Set AI_PROVIDER="groq" to use it instead of Gemini.
GROQ_API_KEY=
# GROQ_MODEL="llama-3.3-70b-versatile"

# Meta (Instagram/Facebook) app credentials (optional — official APIs only).
# No automated discovery or cold DM sending is supported by Meta's APIs.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=

# ── Zero-spend mode + free-tier safety ceilings ───────────────────────────
# ZERO_SPEND_MODE defaults to true (ON). The app never moves to paid usage.
# Per-provider INTERNAL safety ceilings sit BELOW vendor free tiers — the
# app stops BEFORE they are reached. All configurable server-side.
# ZERO_SPEND_MODE=true
# GOOGLE_PLACES_MONTHLY_CEILING=4000
# TAVILY_MONTHLY_CEILING=900
# GEOAPIFY_DAILY_CEILING=2500
# GEMINI_GROUNDING_DAILY_CEILING=400
# GROQ_DAILY_CEILING=1000
