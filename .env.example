# ── WDD AI SALES OS — environment template ──────────────────────────────
# Copy to .env.local for development. NEVER commit real values.

# ── Database (required) ─────────────────────────────────────────────────
# Neon (recommended) / Supabase / any PostgreSQL with pgvector extension.
DATABASE_URL="postgresql://user:password@host:5432/wdd_sales_os?sslmode=require"

# ── Auth (required) ─────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET="CHANGE_ME_generate_with_openssl_rand_base64_32"
# Public app URL (used for OAuth callbacks + email links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Public site URL for SEO metadata (canonical + Open Graph). Set to the
# production domain at deploy time; falls back to the vercel.app URL.
NEXT_PUBLIC_SITE_URL="https://wdd-ai-sales-os.vercel.app"

# ── Google OAuth (optional — login button hidden when unset) ─────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Set to "true" to show the Google button (requires the two vars above).
NEXT_PUBLIC_GOOGLE_OAUTH="false"

# ── Email (required in production for verification + password reset) ─────
RESEND_API_KEY=""
EMAIL_FROM="WDD AI Sales OS <noreply@yourdomain.com>"

# ── AI providers (Phase 3+; at least one needed for AI features) ──────────
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# ── Rate limiting (optional — in-memory fallback used when unset) ─────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Background jobs (Phase 4+ — Inngest) ──────────────────────────────────
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# ── Email verification provider (Phase 2+ — commercial API) ──────────────
EMAIL_VERIFICATION_PROVIDER=""
EMAIL_VERIFICATION_API_KEY=""

# ── Seed helper (optional) ────────────────────────────────────────────────
SEED_DEMO_USER_EMAIL=""

# ── Demo mode (development only — NEVER enable in production) ─────────────
# DEMO_MODE=true shows a "View Demo" button on the login page that opens the
# app shell with clearly labeled DEMO_DATA fixtures — no account, no email
# verification. Hard-gated: it can never activate when NODE_ENV=production.
# Writes and external actions are blocked with "Demo Mode — Action Disabled".
# DEMO_MODE=false

# ── Lead discovery (Phase 2 — Google Places) ──────────────────────────────
# Server-side only. NEVER expose as NEXT_PUBLIC_* — the key is sent as the
# X-Goog-Api-Key header from API routes and never reaches the browser.
# When unset, discovery shows a "Google Places not connected" state with
# setup instructions instead of crashing.
# GOOGLE_PLACES_API_KEY=""
