// ─── WDD AI SALES OS — Database architecture (Phase 0 design) ────────────────
// PostgreSQL + Prisma. Migrations are the ONLY way to change this schema.
// Every tenant-owned model carries organizationId and is ALWAYS queried
// through the tenant-scoped client (src/security/tenant.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: connection URL lives in prisma.config.ts (migrate) and the
  // client adapter (lib/db.ts) — never in the schema file.
}

// ═══════════════ ENUMS ═══════════════

enum Role {
  OWNER
  ADMIN
  SALES_MANAGER
  SALES_EXECUTIVE
  VIEWER
}

enum LeadStatus {
  NEW
  RESEARCHING
  QUALIFIED
  CONTACTED
  REPLIED
  MEETING
  PROPOSAL
  NEGOTIATION
  WON
  LOST
  NURTURE
}

enum LeadSourceType {
  GOOGLE_BUSINESS
  WEBSITE_SEARCH
  DIRECTORY
  CSV
  MANUAL
  API
  DEMO
}

enum DataLabel {
  VERIFIED      // confirmed from a trustworthy source
  AI_INFERENCE  // generated by AI — must be shown as inference
  USER_PROVIDED // entered/imported by the user
  DEMO_DATA     // fictional seed data for demo mode
}

enum VerificationStatus {
  VALID
  INVALID
  UNKNOWN
  RISKY
  DISPOSABLE
  ROLE_BASED
}

enum Channel {
  EMAIL
  WHATSAPP
  TELEGRAM
  LINKEDIN
  SMS
  MANUAL
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SCHEDULED
  SENDING
  SENT
  DELIVERED
  OPENED
  CLICKED
  REPLIED
  FAILED
  BOUNCED
  CANCELLED
}

enum ApprovalMode {
  AUTO
  MANUAL
  APPROVAL_REQUIRED
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  RETRYING
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum OpportunityStage {
  PROSPECTING
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

enum ProposalStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
}

enum AutomationStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum PlanTier {
  FREE
  PRO
  BUSINESS
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  INCOMPLETE
}

enum WebhookDirection {
  INBOUND
  OUTBOUND
}

// ═══════════════ AUTH (better-auth compatible) ═══════════════
// better-auth manages Session/Account/Verification rows via its Prisma adapter.
// Application code never writes these directly (except via auth.api).

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  memberships  Membership[]
  assignedLeads Lead[]     @relation("AssignedLeads")
  assignedTasks Task[]     @relation("AssignedTasks")
  auditLogs    AuditLog[]
  aiUsage      AIUsage[]

  @@index([email])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?   // better-auth credential (email/password) hash
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
}

// ═══════════════ MULTI-TENANCY ═══════════════

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  // Kill switches
  automationsPaused Boolean @default(false) // PAUSE ALL AUTOMATIONS
  outreachPaused    Boolean @default(false) // STOP ALL OUTREACH
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships   Membership[]
  leads         Lead[]
  companies     Company[]
  contacts      Contact[]
  campaigns     Campaign[]
  conversations Conversation[]
  tasks         Task[]
  opportunities Opportunity[]
  proposals     Proposal[]
  automations   Automation[]
  integrations  Integration[]
  apiCredentials ApiCredential[]
  webhooks      Webhook[]
  notifications Notification[]
  aiUsage       AIUsage[]
  auditLogs     AuditLog[]
  subscription  Subscription?
  messages      Message[]
  discoveryRuns DiscoveryRun[]
  websiteInspections WebsiteInspection[]
  intelligenceReports LeadIntelligence[]
  leadScores    LeadScore[]
  jobs          Job[]
  files         LeadFile[]
  usageCounters UsageCounter[]

  @@index([slug])
}

model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           Role     @default(SALES_EXECUTIVE)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}

// ═══════════════ LEADS ═══════════════

model Lead {
  id             String     @id @default(cuid())
  organizationId String
  // identity
  fullName       String?
  email          String?
  phone          String?
  jobTitle       String?
  companyId      String?
  // classification
  status         LeadStatus     @default(NEW)
  sourceType     LeadSourceType @default(MANUAL)
  sourceDetail   String?        // e.g. "Google Business: industrial equipment"
  industry       String?
  location       String?
  country        String?
  state          String?
  city           String?
  website        String?
  domain         String?        // normalized domain for dedup
  // discovery (Phase 2) — set only from compliant discovery providers
  externalId   String?   // provider-scoped id (e.g. Google place_id) — for dedup
  sourceUrl    String?   // source URL (e.g. Google Maps link) — provenance
  rating       Float?    // provider rating — only when returned, never invented
  reviewCount  Int?      // provider review count — only when returned
  discoveredAt DateTime? // when this lead was discovered
  leadScore      Int            @default(0)
  qualityStars   Int            @default(0) // 0–5, no fake precision
  // outreach state
  lastContactedAt DateTime?
  nextFollowUpAt  DateTime?
  assignedToId    String?
  approvalMode    ApprovalMode @default(APPROVAL_REQUIRED)
  // provenance
  dataLabel     DataLabel @default(USER_PROVIDED)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company      Company?     @relation(fields: [companyId], references: [id])
  assignedTo   User?        @relation("AssignedLeads", fields: [assignedToId], references: [id])

  contacts      Contact[]
  enrichments   LeadEnrichment[]
  provenance    LeadFieldProvenance[]
  websiteInspections WebsiteInspection[]
  intelligenceReports LeadIntelligence[]
  activities    LeadActivity[]
  scores        LeadScore[]
  messages      Message[]
  campaignLinks CampaignEnrollment[]
  followUps     FollowUp[]
  tasks         Task[]
  opportunities Opportunity[]
  proposals     Proposal[]
  notes         Note[]
  files         LeadFile[]
  tags          LeadTag[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, leadScore])
  @@index([organizationId, email])
  @@index([organizationId, phone])
  @@index([organizationId, domain])
  @@index([organizationId, sourceType, externalId])
  @@index([organizationId, sourceType])
  @@index([organizationId, createdAt])
  @@index([organizationId, nextFollowUpAt])
}

model Company {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  domain         String?
  website        String?
  industry       String?
  size           String?  // e.g. "11-50" — VERIFIED only if from a real source
  location       String?
  country        String?
  city           String?
  description    String?  @db.Text
  logoUrl        String?
  dataLabel      DataLabel @default(USER_PROVIDED)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads        Lead[]
  contacts     Contact[]
  websiteInspections WebsiteInspection[]
  intelligenceReports LeadIntelligence[]

  @@index([organizationId])
  @@index([organizationId, domain])
  @@index([organizationId, name])
}

model Contact {
  id             String   @id @default(cuid())
  organizationId String
  leadId         String?
  companyId      String?
  fullName       String
  email          String?
  phone          String?
  jobTitle       String?
  linkedInUrl    String?
  isPrimary      Boolean  @default(false)
  emailVerification VerificationStatus @default(UNKNOWN)
  dataLabel      DataLabel @default(USER_PROVIDED)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  company      Company?     @relation(fields: [companyId], references: [id])

  @@index([organizationId])
  @@index([organizationId, email])
  @@index([leadId])
}

model LeadSource {
  id             String   @id @default(cuid())
  organizationId String
  providerId     String   // 'google-business' | 'csv' | 'manual' | 'api' | 'demo' …
  name           String
  config         Json     @default("{}") // non-secret config only
  isEnabled      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, providerId])
  @@index([organizationId])
}

// Per-field data provenance — the no-hallucination backbone.
model LeadFieldProvenance {
  id             String    @id @default(cuid())
  organizationId String
  leadId         String
  field          String    // 'website' | 'phone' | 'industry' | …
  value          String    @db.Text
  source         String    // 'Company website' | 'User import' | 'AI inference' | 'Demo seed'
  sourceUrl      String?
  retrievedAt    DateTime  @default(now())
  label          DataLabel
  confidence     Int?      // 0–100, null when not applicable

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([leadId])
  @@index([leadId, field])
}

model LeadEnrichment {
  id             String    @id @default(cuid())
  organizationId String
  leadId         String
  kind           String    // 'company-research' | 'website-analysis' | 'social-discovery' …
  summary        String?   @db.Text
  data           Json      @default("{}")
  sources        Json      @default("[]") // [{label, url}]
  label          DataLabel
  createdAt      DateTime  @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([leadId])
  @@index([leadId, kind])
}

model LeadActivity {
  id             String   @id @default(cuid())
  organizationId String
  leadId         String
  type           String   // 'discovered' | 'researched' | 'scored' | 'email-sent' | 'note' …
  title          String
  detail         String?  @db.Text
  actorId        String?  // user id or 'system' / 'ai'
  createdAt      DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([leadId])
  @@index([leadId, createdAt])
}

model LeadScore {
  id             String   @id @default(cuid())
  organizationId String
  leadId         String
  score          Int      // 0–100
  scoreBand      String   @default("") // Low Fit | Moderate Fit | Strong Fit | Very Strong Fit
  scoringVersion String   @default("v1")
  factors        Json     @default("[]") // structured factor breakdown (Phase 2 Step 4)
  evidence       Json     @default("[]") // consolidated evidence refs
  confidence     String?  // AI confidence when AI-enriched
  provider       String   @default("deterministic") // 'deterministic' | 'gemini'
  aiEnriched     Boolean  @default(false)
  aiAssessment   Json?    // optional AI interpretation, always AI_INFERENCE
  warnings       Json     @default("[]")
  breakdown      Json     // legacy Phase 1 breakdown (kept for compatibility)
  whyHigh        String?  @db.Text // legacy Phase 1 (kept for compatibility)
  model          String   // scoring engine id, e.g. 'wdd-scoring-v1'
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, leadId])
  @@index([leadId])
  @@index([leadId, createdAt])
}

model DiscoveryRun {
  id             String        @id @default(cuid())
  organizationId String
  providerId     String
  params         Json          // search params (country, city, industry, keywords, limit…)
  status         JobStatus     @default(QUEUED)
  stats          Json          @default("{}") // {searched, found, enriched, scored, deduped}
  error          String?       @db.Text
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, createdAt])
}

enum InspectionStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

model WebsiteInspection {
  id             String           @id @default(cuid())
  organizationId String
  leadId         String?
  companyId      String?
  requestedUrl   String
  finalUrl       String?
  httpStatus     Int?
  status         InspectionStatus @default(QUEUED)
  findings       Json             @default("{}")
  error          String?          @db.Text
  dataLabel      DataLabel        @default(VERIFIED)
  inspectedAt    DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([leadId])
  @@index([companyId])
}

model LeadIntelligence {
  id             String    @id @default(cuid())
  organizationId String
  leadId         String
  companyId      String?
  status         JobStatus @default(QUEUED)
  provider       String    @default("gemini")
  model          String?
  promptVersion  String    @default("v1")
  schemaVersion  String    @default("v1")
  intelligence   Json      @default("{}") // validated structured output + server meta
  confidence     String?   // HIGH | MEDIUM | LOW
  warnings       Json      @default("[]") // server-side evidence-guard warnings
  error          String?   @db.Text
  tokensIn       Int       @default(0)
  tokensOut      Int       @default(0)
  generatedAt    DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, leadId])
  @@index([leadId, createdAt])
}

model Tag {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  color          String   @default("#D4AF37")

  leads LeadTag[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model LeadTag {
  leadId String
  tagId  String

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([leadId, tagId])
}

model Note {
  id             String   @id @default(cuid())
  organizationId String
  leadId         String
  authorId       String
  body           String   @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([leadId])
}

model LeadFile {
  id             String   @id @default(cuid())
  organizationId String
  leadId         String?
  fileName       String
  mimeType       String
  sizeBytes      Int
  storageKey     String   // private object-storage key, never public
  uploadedById   String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([leadId])
}

// ═══════════════ OUTREACH / CONVERSATIONS ═══════════════

model Conversation {
  id             String   @id @default(cuid())
  organizationId String
  leadId         String?
  channel        Channel
  externalId     String?  // provider thread id
  subject        String?
  lastMessageAt  DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages       Message[]

  @@index([organizationId])
  @@index([organizationId, channel])
  @@index([leadId])
}

model Message {
  id             String           @id @default(cuid())
  organizationId String
  conversationId String?
  leadId         String?
  campaignId     String?
  channel        Channel
  direction      MessageDirection
  status         MessageStatus    @default(DRAFT)
  subject        String?
  body           String           @db.Text
  // approval trail
  approvalMode   ApprovalMode     @default(APPROVAL_REQUIRED)
  approvedById   String?
  approvedAt     DateTime?
  scheduledAt    DateTime?
  sentAt         DateTime?
  // provider bookkeeping
  provider       String?
  providerMsgId  String?
  error          String?          @db.Text
  // provenance
  personalizationUsed String?     @db.Text
  dataLabel      DataLabel        @default(USER_PROVIDED)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id])
  lead         Lead?         @relation(fields: [leadId], references: [id])
  campaign     Campaign?     @relation(fields: [campaignId], references: [id])

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, channel])
  @@index([leadId])
  @@index([campaignId])
  @@index([scheduledAt])
}

// ═══════════════ CAMPAIGNS ═══════════════

model Campaign {
  id             String         @id @default(cuid())
  organizationId String
  name           String
  description    String?        @db.Text
  status         CampaignStatus @default(DRAFT)
  channels       Channel[]      @default([])
  dailyLimit     Int            @default(50)
  approvalMode   ApprovalMode   @default(APPROVAL_REQUIRED)
  timezone       String         @default("Asia/Kolkata")
  startDate      DateTime?
  endDate        DateTime?
  icp            Json           @default("{}")
  createdById    String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  steps        CampaignStep[]
  enrollments  CampaignEnrollment[]
  messages     Message[]

  @@index([organizationId])
  @@index([organizationId, status])
}

model CampaignStep {
  id         String   @id @default(cuid())
  campaignId String
  order      Int
  channel    Channel
  delayDays  Int      @default(0) // days after previous step
  subject    String?
  template   String   @db.Text    // supports {{variables}}
  isActive   Boolean  @default(true)

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@unique([campaignId, order])
}

model CampaignEnrollment {
  id             String    @id @default(cuid())
  organizationId String
  campaignId     String
  leadId         String
  currentStep    Int       @default(0)
  status         String    @default("ENROLLED") // ENROLLED|IN_PROGRESS|COMPLETED|STOPPED|REPLIED
  stoppedReason  String?
  enrolledAt     DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([campaignId, leadId])
  @@index([organizationId])
  @@index([leadId])
}

model FollowUp {
  id             String     @id @default(cuid())
  organizationId String
  leadId         String
  campaignId     String?
  channel        Channel
  scheduledAt    DateTime
  status         MessageStatus @default(SCHEDULED)
  body           String?    @db.Text
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, scheduledAt])
  @@index([leadId])
}

// ═══════════════ CRM: TASKS / OPPORTUNITIES / PROPOSALS ═══════════════

model Task {
  id             String       @id @default(cuid())
  organizationId String
  title          String
  detail         String?      @db.Text
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  dueAt          DateTime?
  leadId         String?
  assignedToId   String?
  createdById    String
  // approval tasks carry the pending message
  messageId      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id])
  assignedTo   User?        @relation("AssignedTasks", fields: [assignedToId], references: [id])

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([assignedToId])
  @@index([leadId])
}

model Opportunity {
  id             String           @id @default(cuid())
  organizationId String
  title          String
  leadId         String?
  stage          OpportunityStage @default(PROSPECTING)
  value          Decimal?         @db.Decimal(14, 2)
  currency       String           @default("INR")
  probability    Int              @default(0) // 0–100, user/AI estimate — labeled
  expectedClose  DateTime?
  ownerId        String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id])

  @@index([organizationId])
  @@index([organizationId, stage])
}

model Proposal {
  id             String         @id @default(cuid())
  organizationId String
  title          String
  leadId         String?
  opportunityId  String?
  status         ProposalStatus @default(DRAFT)
  content        Json           @default("{}") // structured proposal blocks
  storageKey     String?        // generated PDF, private
  sentAt         DateTime?
  createdById    String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id])

  @@index([organizationId])
  @@index([leadId])
}

// ═══════════════ AUTOMATION ═══════════════

model Automation {
  id             String           @id @default(cuid())
  organizationId String
  name           String
  description    String?          @db.Text
  status         AutomationStatus @default(ACTIVE)
  createdById    String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  triggers     AutomationTrigger[]
  conditions   AutomationCondition[]
  actions      AutomationAction[]

  @@index([organizationId])
  @@index([organizationId, status])
}

model AutomationTrigger {
  id           String @id @default(cuid())
  automationId String
  type         String // 'new-lead' | 'lead-qualified' | 'reply-received' | 'score-changed' | 'schedule' | 'manual' …
  config       Json   @default("{}")

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId])
}

model AutomationCondition {
  id           String @id @default(cuid())
  automationId String
  order        Int
  field        String // 'leadScore' | 'status' | 'channel' …
  operator     String // 'gt' | 'lt' | 'eq' | 'contains' …
  value        String

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId])
}

model AutomationAction {
  id           String @id @default(cuid())
  automationId String
  order        Int
  type         String // 'research-lead' | 'score-lead' | 'generate-message' | 'create-task' |
                      // 'send-email' | 'send-whatsapp' | 'send-telegram' | 'update-crm' |
                      // 'assign-lead' | 'create-followup' | 'notify-user' | 'delay'
  config       Json   @default("{}")
  // delays are actions too: {type:'delay', config:{days:3}}
  requiresApproval Boolean @default(true)

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId])
}

// ═══════════════ INTEGRATIONS / CREDENTIALS / WEBHOOKS ═══════════════

model Integration {
  id             String   @id @default(cuid())
  organizationId String
  provider       String   // 'google' | 'resend' | 'smtp' | 'gmail' | 'msgraph' |
                          // 'whatsapp' | 'telegram' | 'instagram' | 'linkedin' | 'ai'
  status         String   @default("DISCONNECTED") // CONNECTED|DISCONNECTED|ERROR
  config         Json     @default("{}") // NON-SECRET config only
  lastTestedAt   DateTime?
  lastError      String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
  @@index([organizationId])
}

model ApiCredential {
  id             String   @id @default(cuid())
  organizationId String
  provider       String
  label          String   // user-given name
  // encrypted at rest (AES-256-GCM, key from env). NEVER returned in full.
  encryptedValue String  @db.Text
  lastFour       String? // "••••1234" display
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, provider])
}

model Webhook {
  id             String           @id @default(cuid())
  organizationId String
  direction      WebhookDirection
  provider       String
  url            String?
  secretLastFour String?
  status         String           @default("ACTIVE")
  lastDeliveryAt DateTime?
  lastError      String?          @db.Text
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// ═══════════════ JOBS / NOTIFICATIONS / AI / AUDIT ═══════════════

model Job {
  id             String    @id @default(cuid())
  organizationId String?   // null = platform-level
  name           String    // 'leadDiscovery' | 'leadEnrichment' | 'companyResearch' |
                           // 'leadScoring' | 'messageGeneration' | 'campaignExecution' |
                           // 'followUp' | 'analyticsAggregation'
  payload        Json      @default("{}")
  status         JobStatus @default(QUEUED)
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3)
  error          String?   @db.Text
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
  @@index([name, status])
  @@index([createdAt])
}

model Notification {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?  // null = all members
  type           String   // 'new-lead' | 'lead-qualified' | 'reply' | 'followup-due' |
                           // 'campaign-done' | 'integration-failure' | 'security-event'
  title          String
  body           String?  @db.Text
  link           String?
  readAt         DateTime?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, userId])
  @@index([userId, readAt])
}

model AIUsage {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  provider       String   // 'gemini' | 'openai' | 'anthropic' | 'local'
  model          String
  operation      String   // 'research' | 'scoring' | 'message-generation' | 'assistant' …
  tokensIn       Int      @default(0)
  tokensOut      Int      @default(0)
  estimatedCost  Decimal  @default(0) @db.Decimal(10, 6) // USD
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([userId])
}

model UsageCounter {
  id             String   @id @default(cuid())
  organizationId String
  period         String   // 'YYYY-MM-DD' (daily) — quotas reset daily
  leadsCreated   Int      @default(0)
  discoveries    Int      @default(0)
  discoveryRecords Int    @default(0) // records discovered via discovery search
  discoveryImports Int    @default(0) // discovered records imported as leads
  websiteInspections Int  @default(0) // website inspections run
  aiIntelligence     Int  @default(0) // AI lead-intelligence generations
  leadScoring        Int  @default(0) // lead scoring generations
  messagesSent   Int      @default(0)
  aiTokens       Int      @default(0)
  campaignsLaunched Int   @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, period])
  @@index([organizationId])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?  // null = platform-level (e.g. failed login)
  actorId        String?  // user id | 'system' | 'api'
  action         String   // 'lead.created' | 'message.approved' | 'auth.login' …
  resource       String?  // 'Lead' | 'Campaign' …
  resourceId     String?
  result         String   @default("SUCCESS") // SUCCESS|DENIED|FAILED
  ip             String?
  userAgent      String?
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?         @relation(fields: [actorId], references: [id])

  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([actorId])
  @@index([action])
}

// ═══════════════ BILLING (architecture; processing = later) ═══════════════

model Plan {
  id          String   @id @default(cuid())
  tier        PlanTier @unique
  name        String
  // limits enforced by quotas.ts
  maxLeads    Int
  maxUsers    Int
  aiTokensPerDay Int
  messagesPerDay Int
  discoverySearchesPerDay Int @default(20)
  discoveryRecordsPerDay  Int @default(200)
  websiteInspectionsPerDay Int @default(25)
  aiIntelligencePerDay    Int @default(25)
  leadScoringPerDay       Int @default(100)
  features    Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id             String             @id @default(cuid())
  organizationId String             @unique
  planId         String
  status         SubscriptionStatus @default(TRIALING)
  provider       String?            // 'stripe' — when wired
  providerSubId  String?
  currentPeriodEnd DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id])
  events       PaymentEvent[]

  @@index([status])
}

model PaymentEvent {
  id             String   @id @default(cuid())
  subscriptionId String
  provider       String
  type           String   // 'checkout.completed' | 'invoice.paid' | …
  payload        Json
  createdAt      DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
}
