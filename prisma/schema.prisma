// ─── WDD AI SALES OS — Database architecture (Phase 0 design) ────────────────
// PostgreSQL + Prisma. Migrations are the ONLY way to change this schema.
// Every tenant-owned model carries organizationId and is ALWAYS queried
// through the tenant-scoped client (src/security/tenant.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: connection URL lives in prisma.config.ts (migrate) and the
  // client adapter (lib/db.ts) — never in the schema file.
}

// ═══════════════ ENUMS ═══════════════

enum Role {
  OWNER
  ADMIN
  SALES_MANAGER
  SALES_EXECUTIVE
  VIEWER
}

enum LeadStatus {
  NEW
  RESEARCHING
  QUALIFIED
  CONTACTED
  REPLIED
  MEETING
  PROPOSAL
  NEGOTIATION
  WON
  LOST
  NURTURE
  VERIFIED
  FOLLOW_UP
  CONVERTED
  NOT_RELEVANT
}

enum LeadSourceType {
  GOOGLE_BUSINESS
  GEOAPIFY
  OPENSTREETMAP
  WEB_SEARCH
  WEBSITE_SEARCH
  DIRECTORY
  META
  GOVERNMENT_REGISTRY
  CSV
  MANUAL
  API
  DEMO
  INSTAGRAM
}

enum InstagramConnectionStatus {
  CONNECTED
  NOT_CONNECTED
  UNKNOWN
}

enum DataLabel {
  VERIFIED      // confirmed from a trustworthy source
  AI_INFERENCE  // generated by AI — must be shown as inference
  USER_PROVIDED // entered/imported by the user
  DEMO_DATA     // fictional seed data for demo mode
}

enum VerificationStatus {
  VALID
  INVALID
  UNKNOWN
  RISKY
  DISPOSABLE
  ROLE_BASED
}

enum Channel {
  EMAIL
  WHATSAPP
  TELEGRAM
  LINKEDIN
  SMS
  MANUAL
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SCHEDULED
  SENDING
  SENT
  DELIVERED
  OPENED
  CLICKED
  REPLIED
  FAILED
  BOUNCED
  CANCELLED
}

enum ApprovalMode {
  AUTO
  MANUAL
  APPROVAL_REQUIRED
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  RETRYING
  CANCELLED
}

/** Scope of an AgentMemory record (Phase 5). */
enum AgentMemoryScope {
  ORG
  RUN
  LEAD
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum OpportunityStage {
  PROSPECTING
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

enum ProposalStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
}

enum AutomationStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum PlanTier {
  FREE
  PRO
  BUSINESS
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  INCOMPLETE
}

enum WebhookDirection {
  INBOUND
  OUTBOUND
}

// ═══════════════ AUTH (better-auth compatible) ═══════════════
// better-auth manages Session/Account/Verification rows via its Prisma adapter.
// Application code never writes these directly (except via auth.api).

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  memberships  Membership[]
  assignedLeads Lead[]     @relation("AssignedLeads")
  assignedTasks Task[]     @relation("AssignedTasks")
  auditLogs    AuditLog[]
  aiUsage      AIUsage[]

  @@index([email])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?   // better-auth credential (email/password) hash
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
}

// ═══════════════ MULTI-TENANCY ═══════════════

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  // Kill switches
  automationsPaused Boolean @default(false) // PAUSE ALL AUTOMATIONS
  outreachPaused    Boolean @default(false) // STOP ALL OUTREACH
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships   Membership[]
  leads         Lead[]
  companies     Company[]
  contacts      Contact[]
  campaigns     Campaign[]
  conversations Conversation[]
  tasks         Task[]
  opportunities Opportunity[]
  proposals     Proposal[]
  automations   Automation[]
  integrations  Integration[]
  apiCredentials ApiCredential[]
  webhooks      Webhook[]
  notifications Notification[]
  aiUsage       AIUsage[]
  auditLogs     AuditLog[]
  subscription  Subscription?
  messages      Message[]
  instagramOutreachBatches InstagramOutreachBatch[]
  instagramOutreachItems   InstagramOutreachItem[]
  instagramProspectingPlans InstagramProspectingPlan[]
  instagramProspectingRuns  InstagramProspectingRun[]
  discoveryRuns DiscoveryRun[]
  websiteInspections WebsiteInspection[]
  intelligenceReports LeadIntelligence[]
  leadScores    LeadScore[]
  jobs          Job[]
  agentMemories AgentMemory[]
  agentApprovals AgentApproval[]
  files         LeadFile[]
  usageCounters UsageCounter[]
  discoveryProfiles DiscoveryProfile[]
  discoveryHistory  DiscoveryHistory[]
  providerUsage     ProviderUsage[]

  @@index([slug])
}

model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           Role     @default(SALES_EXECUTIVE)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}

// ═══════════════ LEADS ═══════════════

model Lead {
  id             String     @id @default(cuid())
  organizationId String
  // identity
  fullName       String?
  email          String?
  phone          String?
  jobTitle       String?
  companyId      String?
  // classification
  status         LeadStatus     @default(NEW)
  sourceType     LeadSourceType @default(MANUAL)
  sourceDetail   String?        // e.g. "Google Business: industrial equipment"
  industry       String?
  location       String?
  country        String?
  state          String?
  city           String?
  website        String?
  domain         String?        // normalized domain for dedup
  // discovery (Phase 2) — set only from compliant discovery providers
  externalId   String?   // provider-scoped id (e.g. Google place_id) — for dedup
  sourceUrl    String?   // source URL (e.g. Google Maps link) — provenance
  rating       Float?    // provider rating — only when returned, never invented
  reviewCount  Int?      // provider review count — only when returned
  discoveredAt DateTime? // when this lead was discovered
  lastVerifiedAt DateTime? // when a source last confirmed this lead's data
  // discovery workspace (Phase 8) — set only from normalized LeadCandidate data
  websiteStatus   String? // NO_WEBSITE | HAS_WEBSITE | UNKNOWN — never invented
  opportunityType String? // HIGH | MEDIUM | LOW | UNKNOWN — deterministic tier from verified signals only
  opportunityReason String? // deterministic reason, e.g. "No website + phone available + target industry 'manufacturer'"
  contactable     Boolean @default(false) // true when phone/email/social/contact URL exists
  googleMapsUrl   String? // provider Google Maps link — VERIFIED_DATA only
  instagramUrl    String? // never invented; null when unknown
  instagramUsername String? // normalized lowercase handle — dedup key for IG prospecting
  instagramConnectionStatus InstagramConnectionStatus @default(UNKNOWN) // never guessed; UNKNOWN until verified or set by user
  aiMessage       String? @db.Text // generated IG outreach draft (quality-gated); user sends manually
  aiMessageSource String? // "ai" | "template"
  aiMessageAt     DateTime? // when the draft was generated
  // ── Verification (AI sales agent; source-backed, never invented) ──
  verificationConfidence VerificationConfidence? // HIGH/MEDIUM/LOW/REJECTED; null = not run through the verification engine
  verificationReason     String? @db.Text // why this confidence was assigned (source-backed)
  verificationSources    Json? // bounded array of {provider, sourceType, url, retrievedAt, label}
  verifiedAt             DateTime?
  industryRelevance      Int? // 0-100 from the industry classifier; null when not classified
  industryReasoning      String? @db.Text // source-backed reasoning for the industry classification
  followerCount          Int? // only when a compliant source provides it; never invented
  followerCountStatus    FollowerCountStatus @default(UNKNOWN) // UNVERIFIED when a threshold is configured but count is unavailable
  mergedSourceTypes      Json? // source types merged into this lead by cross-source entity matching, e.g. ["GOOGLE_BUSINESS","INSTAGRAM"]
  facebookUrl     String? // never invented; null when unknown
  linkedinUrl     String? // manual or provider-provided; null when unknown
  leadScore      Int            @default(0)
  scoreReason    String?        // deterministic breakdown, e.g. "No website +25 · Phone +20 · Target industry +15"
  qualityStars   Int            @default(0) // 0–5, no fake precision
  // outreach state
  lastContactedAt DateTime?
  nextFollowUpAt  DateTime?
  assignedToId    String?
  approvalMode    ApprovalMode @default(APPROVAL_REQUIRED)
  // provenance
  dataLabel     DataLabel @default(USER_PROVIDED)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company      Company?     @relation(fields: [companyId], references: [id])
  assignedTo   User?        @relation("AssignedLeads", fields: [assignedToId], references: [id])

  contacts      Contact[]
  enrichments   LeadEnrichment[]
  provenance    LeadFieldProvenance[]
  websiteInspections WebsiteInspection[]
  intelligenceReports LeadIntelligence[]
  activities    LeadActivity[]
  scores        LeadScore[]
  messages      Message[]
  instagramOutreachItems InstagramOutreachItem[]
  campaignLinks CampaignEnrollment[]
  followUps     FollowUp[]
  tasks         Task[]
  opportunities Opportunity[]
  proposals     Proposal[]
  notes         Note[]
  files         LeadFile[]
  tags          LeadTag[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, leadScore])
  @@index([organizationId, email])
  @@index([organizationId, phone])
  @@index([organizationId, domain])
  @@index([organizationId, sourceType, externalId])
  @@index([organizationId, sourceType])
  @@index([organizationId, createdAt])
  @@index([organizationId, nextFollowUpAt])
  @@index([organizationId, instagramUsername])
}

model Company {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  domain         String?
  website        String?
  industry       String?
  size           String?  // e.g. "11-50" — VERIFIED only if from a real source
  location       String?
  country        String?
  city           String?
  description    String?  @db.Text
  logoUrl        String?
  dataLabel      DataLabel @default(USER_PROVIDED)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads        Lead[]
  contacts     Contact[]
  websiteInspections WebsiteInspection[]
  intelligenceReports LeadIntelligence[]

  @@index([organizationId])
  @@index([organizationId, domain])
  @@index([organizationId, name])
}

model Contact {
  id             String   @id @default(cuid())
  organizationId String
  leadId         String?
  companyId      String?
  fullName       String
  email          String?
  phone          String?
  jobTitle       String?
  linkedInUrl    String?
  isPrimary      Boolean  @default(false)
  emailVerification VerificationStatus @default(UNKNOWN)
  dataLabel      DataLabel @default(USER_PROVIDED)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  company      Company?     @relation(fields: [companyId], references: [id])

  @@index([organizationId])
  @@index([organizationId, email])
  @@index([leadId])
}

model LeadSource {
  id             String   @id @default(cuid())
  organizationId String
  providerId     String   // 'google-business' | 'csv' | 'manual' | 'api' | 'demo' …
  name           String
  config         Json     @default("{}") // non-secret config only
  isEnabled      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, providerId])
  @@index([organizationId])
}

// Per-field data provenance — the no-hallucination backbone.
model LeadFieldProvenance {
  id             String    @id @default(cuid())
  organizationId String
  leadId         String
  field          String    // 'website' | 'phone' | 'industry' | …
  value          String    @db.Text
  source         String    // 'Company website' | 'User import' | 'AI inference' | 'Demo seed'
  sourceUrl      String?
  retrievedAt    DateTime  @default(now())
  label          DataLabel
  confidence     Int?      // 0–100, null when not applicable

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([leadId])
  @@index([leadId, field])
}

model LeadEnrichment {
  id             String    @id @default(cuid())
  organizationId String
  leadId         String
  kind           String    // 'company-research' | 'website-analysis' | 'social-discovery' …
  summary        String?   @db.Text
  data           Json      @default("{}")
  sources        Json      @default("[]") // [{label, url}]
  label          DataLabel
  createdAt      DateTime  @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([leadId])
  @@index([leadId, kind])
}

model LeadActivity {
  id             String   @id @default(cuid())
  organizationId String
  leadId         String
  type           String   // 'discovered' | 'researched' | 'scored' | 'email-sent' | 'note' …
  title          String
  detail         String?  @db.Text
  actorId        String?  // user id or 'system' / 'ai'
  createdAt      DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([leadId])
  @@index([leadId, createdAt])
}

model LeadScore {
  id             String   @id @default(cuid())
  organizationId String
  leadId         String
  score          Int      // 0–100
  scoreBand      String   @default("") // Low Fit | Moderate Fit | Strong Fit | Very Strong Fit
  scoringVersion String   @default("v1")
  factors        Json     @default("[]") // structured factor breakdown (Phase 2 Step 4)
  evidence       Json     @default("[]") // consolidated evidence refs
  confidence     String?  // AI confidence when AI-enriched
  provider       String   @default("deterministic") // 'deterministic' | 'gemini'
  aiEnriched     Boolean  @default(false)
  aiAssessment   Json?    // optional AI interpretation, always AI_INFERENCE
  warnings       Json     @default("[]")
  breakdown      Json     // legacy Phase 1 breakdown (kept for compatibility)
  whyHigh        String?  @db.Text // legacy Phase 1 (kept for compatibility)
  model          String   // scoring engine id, e.g. 'wdd-scoring-v1'
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, leadId])
  @@index([leadId])
  @@index([leadId, createdAt])
}

model DiscoveryRun {
  id             String        @id @default(cuid())
  organizationId String
  providerId     String
  params         Json          // search params (country, city, industry, keywords, limit…)
  status         JobStatus     @default(QUEUED)
  stats          Json          @default("{}") // {searched, found, enriched, scored, deduped}
  error          String?       @db.Text
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, createdAt])
}

enum InspectionStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

model WebsiteInspection {
  id             String           @id @default(cuid())
  organizationId String
  leadId         String?
  companyId      String?
  requestedUrl   String
  finalUrl       String?
  httpStatus     Int?
  status         InspectionStatus @default(QUEUED)
  findings       Json             @default("{}")
  error          String?          @db.Text
  dataLabel      DataLabel        @default(VERIFIED)
  inspectedAt    DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([leadId])
  @@index([companyId])
}

model LeadIntelligence {
  id             String    @id @default(cuid())
  organizationId String
  leadId         String
  companyId      String?
  status         JobStatus @default(QUEUED)
  provider       String    @default("gemini")
  model          String?
  promptVersion  String    @default("v1")
  schemaVersion  String    @default("v1")
  intelligence   Json      @default("{}") // validated structured output + server meta
  confidence     String?   // HIGH | MEDIUM | LOW
  warnings       Json      @default("[]") // server-side evidence-guard warnings
  error          String?   @db.Text
  tokensIn       Int       @default(0)
  tokensOut      Int       @default(0)
  generatedAt    DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, leadId])
  @@index([leadId, createdAt])
}

model Tag {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  color          String   @default("#D4AF37")

  leads LeadTag[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model LeadTag {
  leadId String
  tagId  String

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([leadId, tagId])
}

model Note {
  id             String   @id @default(cuid())
  organizationId String
  leadId         String
  authorId       String
  body           String   @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([leadId])
}

model LeadFile {
  id             String   @id @default(cuid())
  organizationId String
  leadId         String?
  fileName       String
  mimeType       String
  sizeBytes      Int
  storageKey     String   // private object-storage key, never public
  uploadedById   String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([leadId])
}

// ═══════════════ OUTREACH / CONVERSATIONS ═══════════════

model Conversation {
  id             String   @id @default(cuid())
  organizationId String
  leadId         String?
  channel        Channel
  externalId     String?  // provider thread id
  subject        String?
  lastMessageAt  DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages       Message[]

  @@index([organizationId])
  @@index([organizationId, channel])
  @@index([leadId])
}

// ═══════════════ INSTAGRAM OUTREACH ASSISTANT ═══════════════════════════
// Human-in-the-loop assisted outreach. The user pastes Instagram usernames;
// the system researches public information and drafts personalized messages.
// The user reviews, copies, opens the profile, and sends MANUALLY.
// There is deliberately NO automated sending, NO credential storage,
// NO session handling, and NO Instagram scraping in these models.

enum InstagramOutreachItemStatus {
  DRAFT     // message generated, awaiting user review
  COPIED    // user copied the message (about to / has sent manually)
  CONTACTED // user confirmed they sent the message manually
}

model InstagramOutreachBatch {
  id             String   @id @default(cuid())
  organizationId String
  name           String?
  totalUsernames Int      @default(0)
  createdById    String
  createdAt      DateTime @default(now())

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        InstagramOutreachItem[]

  @@index([organizationId])
  @@index([organizationId, createdAt])
}

model InstagramOutreachItem {
  id             String @id @default(cuid())
  organizationId String
  batchId        String
  username       String // normalized: lowercase, no @, 1-30 chars [a-z0-9._]
  profileUrl     String // canonical https://www.instagram.com/{username}/
  status         InstagramOutreachItemStatus @default(DRAFT)

  // ── Public research (never scraped from Instagram; never invented) ──
  businessName       String?
  category           String?
  location           String?
  website            String?
  observations       String?   @db.Text // AI summary of public findings, or null
  researchSources    String[]  // e.g. ["tavily:web search"] — always listed
  researchConfidence String?   // HIGH | MEDIUM | LOW | INSUFFICIENT
  researchFailed     Boolean   @default(false)
  researchError      String?
  researchedAt       DateTime?
  pitchAngle         String?   // NEW_WEBSITE | REDESIGN | UX_CONVERSION | SEO | LOCAL_SEO | PERFORMANCE | CONTENT | GENERAL
  websiteAnalysis    String?   @db.Text // human-readable homepage findings, or null

  // ── Draft message (user reviews, copies, sends manually) ──
  messageDraft    String?   @db.Text // AI-generated or template fallback
  messageSource   String?   // "ai" | "template"
  messageEdited   String?   @db.Text // user's edited version (the one to copy)
  messageEditedAt DateTime?
  dataLabel       DataLabel @default(AI_INFERENCE)

  // ── CRM link (optional; reuses canonical Lead + LeadActivity) ──
  leadId      String?
  copiedAt    DateTime?
  contactedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  batch        InstagramOutreachBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  lead         Lead?                  @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@unique([organizationId, batchId, username])
  @@index([organizationId])
  @@index([batchId])
  @@index([leadId])
}

model Message {
  id             String           @id @default(cuid())
  organizationId String
  conversationId String?
  leadId         String?
  campaignId     String?
  channel        Channel
  direction      MessageDirection
  status         MessageStatus    @default(DRAFT)
  subject        String?
  body           String           @db.Text
  // approval trail
  approvalMode   ApprovalMode     @default(APPROVAL_REQUIRED)
  approvedById   String?
  approvedAt     DateTime?
  scheduledAt    DateTime?
  sentAt         DateTime?
  // provider bookkeeping
  provider       String?
  providerMsgId  String?
  error          String?          @db.Text
  // provenance
  personalizationUsed String?     @db.Text
  dataLabel      DataLabel        @default(USER_PROVIDED)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id])
  lead         Lead?         @relation(fields: [leadId], references: [id])
  campaign     Campaign?     @relation(fields: [campaignId], references: [id])

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, channel])
  @@index([leadId])
  @@index([campaignId])
  @@index([scheduledAt])
}

// ═══════════════ INSTAGRAM PROSPECTING — 7-DAY WEEKLY PLAN + DAILY RUNS ═══════════════
// Extension of the Instagram Outreach architecture (not a replacement).
// A plan defines one prospecting target per weekday; a scheduler-driven job
// runs the current day's target daily at the plan's runAtTime.

enum ProspectingRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
}

/**
 * Verification confidence for a lead candidate. Assigned by the verification
 * engine from source-backed evidence only — never invented.
 * HIGH: multiple independent sources agree. MEDIUM: one strong source +
 * supporting evidence. LOW: weak/incomplete evidence. REJECTED: contradictory
 * or clearly irrelevant.
 */
enum VerificationConfidence {
  HIGH
  MEDIUM
  LOW
  REJECTED
}

/** Follower count provenance — never guessed. */
enum FollowerCountStatus {
  UNKNOWN
  VERIFIED
  UNVERIFIED
}

model InstagramProspectingPlan {
  id             String   @id @default(cuid())
  organizationId String
  name           String   @default("Weekly Instagram Prospecting")
  isActive       Boolean  @default(true)
  timezone       String   @default("Asia/Kolkata")
  runAtTime      String   @default("09:00") // HH:MM in the plan timezone
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  days         InstagramProspectingDay[]
  runs         InstagramProspectingRun[]

  @@index([organizationId])
  @@index([organizationId, isActive])
}

model InstagramProspectingDay {
  id                String   @id @default(cuid())
  planId            String
  dayOfWeek         Int      // 0=Sunday … 6=Saturday (JS getDay convention)
  industry          String   // e.g. "jewellery", "fashion manufacturers" — never hardcoded in code
  location          String?  // e.g. "Mumbai"
  country           String?  // e.g. "India"
  businessType      String?  // e.g. "manufacturer", "retailer"
  targetAudience    String?  // free-text note, e.g. "B2B wholesalers"
  websitePreference String   @default("ANY") // ANY | NO_WEBSITE | HAS_WEBSITE
  followerThreshold Int?     // stored when configured; NOT enforceable from compliant sources (no follower data)
  targetCount       Int      @default(75) // 70–80/day target
  isActive          Boolean  @default(true)

  plan InstagramProspectingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, dayOfWeek])
  @@index([planId])
}

model InstagramProspectingRun {
  id               String               @id @default(cuid())
  organizationId   String
  planId           String?
  dayOfWeek        Int
  runDate          String               // YYYY-MM-DD in the plan timezone — one run per org per day
  targetCount      Int
  found            Int                  @default(0) // unique usernames discovered
  newCount         Int                  @default(0) // passed global dedup
  duplicatesSkipped Int                 @default(0)
  researched       Int                  @default(0)
  messagesGenerated Int                 @default(0)
  crmImported      Int                  @default(0)
  failed           Int                  @default(0)
  verified         Int                  @default(0) // HIGH + acceptable MEDIUM candidates
  rejected         Int                  @default(0) // LOW/REJECTED or failed verification
  sourceBreakdown  Json? // imported counts per primary source type, e.g. {"GOOGLE_BUSINESS":30,"INSTAGRAM":12}
  durationMs       Int? // wall-clock run duration
  failureReason    String? // NO_SOURCE_CONFIGURED | NO_CANDIDATES | ALL_CANDIDATES_REJECTED | CRM_IMPORT_FAILURE | PROVIDER_ERROR | QUOTA_EXCEEDED | JOB_TIMEOUT | DATABASE_ERROR
  acquisitionNotes Json? // per-source acquisition observability: provider, status, queriesAttempted, resultsReturned, usableCandidates, errors
  processingErrors Json? // bounded list of candidate-level failures: stage, candidateLabel, source, code, message, at
  rejectionReasons Json? // aggregated verification rejection counts by reason
  status           ProspectingRunStatus @default(RUNNING)
  triggeredBy      String               @default("SCHEDULED") // SCHEDULED | MANUAL
  error            String?
  startedAt        DateTime             @default(now())
  finishedAt       DateTime?

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         InstagramProspectingPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@unique([organizationId, runDate])
  @@index([organizationId])
  @@index([organizationId, runDate])
}

// ═══════════════ CAMPAIGNS ═══════════════

model Campaign {
  id             String         @id @default(cuid())
  organizationId String
  name           String
  description    String?        @db.Text
  status         CampaignStatus @default(DRAFT)
  channels       Channel[]      @default([])
  dailyLimit     Int            @default(50)
  approvalMode   ApprovalMode   @default(APPROVAL_REQUIRED)
  timezone       String         @default("Asia/Kolkata")
  startDate      DateTime?
  endDate        DateTime?
  icp            Json           @default("{}")
  createdById    String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  steps        CampaignStep[]
  enrollments  CampaignEnrollment[]
  messages     Message[]

  @@index([organizationId])
  @@index([organizationId, status])
}

model CampaignStep {
  id         String   @id @default(cuid())
  campaignId String
  order      Int
  channel    Channel
  delayDays  Int      @default(0) // days after previous step
  subject    String?
  template   String   @db.Text    // supports {{variables}}
  isActive   Boolean  @default(true)

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@unique([campaignId, order])
}

model CampaignEnrollment {
  id             String    @id @default(cuid())
  organizationId String
  campaignId     String
  leadId         String
  currentStep    Int       @default(0)
  status         String    @default("ENROLLED") // ENROLLED|IN_PROGRESS|COMPLETED|STOPPED|REPLIED
  stoppedReason  String?
  enrolledAt     DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([campaignId, leadId])
  @@index([organizationId])
  @@index([leadId])
}

model FollowUp {
  id             String     @id @default(cuid())
  organizationId String
  leadId         String
  campaignId     String?
  channel        Channel
  scheduledAt    DateTime
  status         MessageStatus @default(SCHEDULED)
  body           String?    @db.Text
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, scheduledAt])
  @@index([leadId])
}

// ═══════════════ CRM: TASKS / OPPORTUNITIES / PROPOSALS ═══════════════

model Task {
  id             String       @id @default(cuid())
  organizationId String
  title          String
  detail         String?      @db.Text
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  dueAt          DateTime?
  leadId         String?
  assignedToId   String?
  createdById    String
  // approval tasks carry the pending message
  messageId      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id])
  assignedTo   User?        @relation("AssignedTasks", fields: [assignedToId], references: [id])

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([assignedToId])
  @@index([leadId])
}

model Opportunity {
  id             String           @id @default(cuid())
  organizationId String
  title          String
  leadId         String?
  stage          OpportunityStage @default(PROSPECTING)
  value          Decimal?         @db.Decimal(14, 2)
  currency       String           @default("INR")
  probability    Int              @default(0) // 0–100, user/AI estimate — labeled
  expectedClose  DateTime?
  ownerId        String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id])

  @@index([organizationId])
  @@index([organizationId, stage])
}

model Proposal {
  id             String         @id @default(cuid())
  organizationId String
  title          String
  leadId         String?
  opportunityId  String?
  status         ProposalStatus @default(DRAFT)
  content        Json           @default("{}") // structured proposal blocks
  storageKey     String?        // generated PDF, private
  sentAt         DateTime?
  createdById    String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id])

  @@index([organizationId])
  @@index([leadId])
}

// ═══════════════ AUTOMATION ═══════════════

model Automation {
  id             String           @id @default(cuid())
  organizationId String
  name           String
  description    String?          @db.Text
  status         AutomationStatus @default(ACTIVE)
  createdById    String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  triggers     AutomationTrigger[]
  conditions   AutomationCondition[]
  actions      AutomationAction[]

  @@index([organizationId])
  @@index([organizationId, status])
}

model AutomationTrigger {
  id           String @id @default(cuid())
  automationId String
  type         String // 'new-lead' | 'lead-qualified' | 'reply-received' | 'score-changed' | 'schedule' | 'manual' …
  config       Json   @default("{}")

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId])
}

model AutomationCondition {
  id           String @id @default(cuid())
  automationId String
  order        Int
  field        String // 'leadScore' | 'status' | 'channel' …
  operator     String // 'gt' | 'lt' | 'eq' | 'contains' …
  value        String

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId])
}

model AutomationAction {
  id           String @id @default(cuid())
  automationId String
  order        Int
  type         String // 'research-lead' | 'score-lead' | 'generate-message' | 'create-task' |
                      // 'send-email' | 'send-whatsapp' | 'send-telegram' | 'update-crm' |
                      // 'assign-lead' | 'create-followup' | 'notify-user' | 'delay'
  config       Json   @default("{}")
  // delays are actions too: {type:'delay', config:{days:3}}
  requiresApproval Boolean @default(true)

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId])
}

// ═══════════════ INTEGRATIONS / CREDENTIALS / WEBHOOKS ═══════════════

model Integration {
  id             String   @id @default(cuid())
  organizationId String
  provider       String   // 'google' | 'resend' | 'smtp' | 'gmail' | 'msgraph' |
                          // 'whatsapp' | 'telegram' | 'instagram' | 'linkedin' | 'ai'
  status         String   @default("DISCONNECTED") // CONNECTED|DISCONNECTED|ERROR
  config         Json     @default("{}") // NON-SECRET config only
  lastTestedAt   DateTime?
  lastError      String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
  @@index([organizationId])
}

model ApiCredential {
  id             String   @id @default(cuid())
  organizationId String
  provider       String
  label          String   // user-given name
  // encrypted at rest (AES-256-GCM, key from env). NEVER returned in full.
  encryptedValue String  @db.Text
  lastFour       String? // "••••1234" display
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, provider])
}

model Webhook {
  id             String           @id @default(cuid())
  organizationId String
  direction      WebhookDirection
  provider       String
  url            String?
  secretLastFour String?
  status         String           @default("ACTIVE")
  lastDeliveryAt DateTime?
  lastError      String?          @db.Text
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// ═══════════════ JOBS / NOTIFICATIONS / AI / AUDIT ═══════════════

model Job {
  id             String    @id @default(cuid())
  organizationId String?   // null = platform-level
  name           String    // 'leadDiscovery' | 'leadEnrichment' | 'companyResearch' |
                           // 'leadScoring' | 'messageGeneration' | 'campaignExecution' |
                           // 'followUp' | 'analyticsAggregation'
  payload        Json      @default("{}")
  status         JobStatus @default(QUEUED)
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3)
  error          String?   @db.Text
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
  @@index([name, status])
  @@index([createdAt])
}

// ═══════════════ AGENT MEMORY (Phase 5) ═══════════════════════════════
// Structured, tenant-isolated memory for the AI Sales Mind. Memory is
// DATA, not instructions — the Mind must never treat it as system rules.
// - ORG:  org-wide sales preferences / ICP / business rules (scopeId = organizationId)
// - RUN:  bounded summary of one AI Sales Mind run (scopeId = runId, short-lived)
// - LEAD: researched facts about one lead (scopeId = lead id, ownership verified in code)
model AgentMemory {
  id             String           @id @default(cuid())
  organizationId String
  scope          AgentMemoryScope
  scopeId        String
  key            String
  value          Json
  expiresAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, scope, scopeId, key])
  @@index([organizationId, scope, scopeId])
  @@index([organizationId, expiresAt])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
  EXECUTED
  FAILED
}

enum ApprovalActionType {
  OUTREACH_DRAFT
  CRM_FOLLOWUP
  CRM_TASK
}

/// Human approval gate for agent/workflow-proposed actions (Phase 7).
/// The record is a SNAPSHOT: proposedInput/target/actionType are immutable
/// after creation — approving executes exactly what was proposed.
model AgentApproval {
  id                String             @id @default(cuid())
  organizationId    String
  workflowId        String
  workflowRunId     String
  stageId           String
  status            ApprovalStatus     @default(PENDING)
  actionType        ApprovalActionType
  proposedInput     Json
  target            Json
  reason            String             @db.Text
  requestedByUserId String
  reviewedByUserId  String?
  reviewedAt        DateTime?
  expiresAt         DateTime?
  executionResult   Json?
  /// Bounded checkpoint of the paused workflow (research stripped) so the
  /// workflow can resume from the next stage without re-running discovery.
  workflowSnapshot  Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
}

model Notification {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?  // null = all members
  type           String   // 'new-lead' | 'lead-qualified' | 'reply' | 'followup-due' |
                           // 'campaign-done' | 'integration-failure' | 'security-event'
  title          String
  body           String?  @db.Text
  link           String?
  metadata       Json?
  readAt         DateTime?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, userId])
  @@index([userId, readAt])
}

model AIUsage {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  provider       String   // 'gemini' | 'openai' | 'anthropic' | 'local'
  model          String
  operation      String   // 'research' | 'scoring' | 'message-generation' | 'assistant' …
  tokensIn       Int      @default(0)
  tokensOut      Int      @default(0)
  estimatedCost  Decimal  @default(0) @db.Decimal(10, 6) // USD
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([userId])
}

model UsageCounter {
  id             String   @id @default(cuid())
  organizationId String
  period         String   // 'YYYY-MM-DD' (daily) — quotas reset daily
  leadsCreated   Int      @default(0)
  discoveries    Int      @default(0)
  discoveryRecords Int    @default(0) // records discovered via discovery search
  discoveryImports Int    @default(0) // discovered records imported as leads
  websiteInspections Int  @default(0) // website inspections run
  aiIntelligence     Int  @default(0) // AI lead-intelligence generations
  leadScoring        Int  @default(0) // lead scoring generations
  messagesSent   Int      @default(0)
  aiTokens       Int      @default(0)
  campaignsLaunched Int   @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, period])
  @@index([organizationId])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?  // null = platform-level (e.g. failed login)
  actorId        String?  // user id | 'system' | 'api'
  action         String   // 'lead.created' | 'message.approved' | 'auth.login' …
  resource       String?  // 'Lead' | 'Campaign' …
  resourceId     String?
  result         String   @default("SUCCESS") // SUCCESS|DENIED|FAILED
  ip             String?
  userAgent      String?
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?         @relation(fields: [actorId], references: [id])

  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([actorId])
  @@index([action])
}

// ═══════════════ BILLING (architecture; processing = later) ═══════════════

model Plan {
  id          String   @id @default(cuid())
  tier        PlanTier @unique
  name        String
  // limits enforced by quotas.ts
  maxLeads    Int
  maxUsers    Int
  aiTokensPerDay Int
  messagesPerDay Int
  discoverySearchesPerDay Int @default(20)
  discoveryRecordsPerDay  Int @default(200)
  websiteInspectionsPerDay Int @default(25)
  aiIntelligencePerDay    Int @default(25)
  leadScoringPerDay       Int @default(100)
  features    Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id             String             @id @default(cuid())
  organizationId String             @unique
  planId         String
  status         SubscriptionStatus @default(TRIALING)
  provider       String?            // 'stripe' — when wired
  providerSubId  String?
  currentPeriodEnd DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id])
  events       PaymentEvent[]

  @@index([status])
}

model PaymentEvent {
  id             String   @id @default(cuid())
  subscriptionId String
  provider       String
  type           String   // 'checkout.completed' | 'invoice.paid' | …
  payload        Json
  createdAt      DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
}

// ── Discovery workspace (lead acquisition) ──────────────────────────────
// Saved discovery profiles: quick daily source switching without a
// scheduler. Config is a JSON snapshot of the run input (sources, filters,
// scoring prefs, outreach channel) — never secrets.

model DiscoveryProfile {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  config         Json     // DiscoveryProfileConfig (see lib/discovery/profiles.ts)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runs         DiscoveryHistory[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

// One row per user-triggered discovery run. Counts are truthful:
// requested vs actually discovered/contactable/imported are stored
// separately and the UI must render them as-is.

model DiscoveryHistory {
  id             String   @id @default(cuid())
  organizationId String
  profileId      String?
  label          String   // human label, e.g. "Manufacturers · Gujarat, India"
  providerIds    Json     @default("[]") // ordered provider ids attempted
  params         Json     // sanitized run params (no secrets)
  requested      Int
  discovered     Int      @default(0) // raw candidates across providers
  deduplicated   Int      @default(0) // after cross-source dedup
  withWebsite    Int      @default(0)
  withoutWebsite Int      @default(0)
  contactable    Int      @default(0)
  unreachable    Int      @default(0)
  imported       Int      @default(0) // leads actually imported to CRM
  duplicate      Int      @default(0) // already in CRM
  perSource      Json     @default("[]") // per-provider breakdown + status
  durationMs     Int?
  status         String   @default("COMPLETE") // COMPLETE | PARTIAL | FAILED | LIMIT_REACHED
  error          String?  @db.Text
  createdById    String?
  createdAt      DateTime @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profile      DiscoveryProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, createdAt])
}

// Zero-spend enforcement ledger. One row per org × provider × period.
// Periods: monthly (YYYY-MM-01 UTC) or daily (YYYY-MM-DD UTC) depending on
// the provider's ceiling. The app blocks BEFORE the ceiling is reached —
// vendor billing alerts are not relied upon.

model ProviderUsage {
  id              String   @id @default(cuid())
  organizationId  String
  provider        String   // provider id, e.g. "google-places"
  period          String   // "month" | "day"
  periodStart     DateTime // UTC start of the period
  requests        Int      @default(0)
  credits         Int      @default(0)
  blockedRequests Int      @default(0)
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider, period, periodStart])
  @@index([organizationId, provider])
}
